# Copy this file to keystore.properties (gitignored) and fill in the values.
# These are read by app/build.gradle.kts when building the release variant.

# Path to the .jks file. Use an absolute path so it works regardless of where
# Gradle is invoked from. Storing the keystore OUTSIDE the repo is recommended.
storeFile=/Users/YOUR_USERNAME/.firebase-keys/weekendout-release.jks

# Keystore password (the one you typed first when running keytool -genkey).
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD

# Alias name (you used "weekendout" in the keytool command).
keyAlias=weekendout

# Key password (same as storePassword if you pressed Enter at the second prompt).
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
